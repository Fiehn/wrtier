@@ -25,8 +25,30 @@ pub struct FstDictionary {
 const EXPECTED_DISTANCE: u8 = 3;
 const TRANSPOSITION_COST_ONE: bool = true;
 
+// WRTIER PATCH: share the curated MutableDictionary (already a static) instead of cloning it
+// and building a second copy of every entry. Only the FST index is new.
 static DICT: LazyLock<Arc<FstDictionary>> =
-    LazyLock::new(|| Arc::new((*MutableDictionary::curated()).clone().into()));
+    LazyLock::new(|| Arc::new(FstDictionary::sharing(MutableDictionary::curated())));
+
+impl FstDictionary {
+    /// An FST over the words of `mutable_dict`, which is kept and shared, not copied.
+    fn sharing(mutable_dict: Arc<MutableDictionary>) -> Self {
+        let word_map = {
+            let mut words: Vec<&[char]> = mutable_dict.words_iter().collect();
+            words.sort_unstable();
+            words.dedup();
+            let mut builder = fst::MapBuilder::memory();
+            for word_chars in words {
+                let word = word_chars.iter().collect::<String>();
+                builder
+                    .insert(word, CanonicalWordId::from_word_chars(word_chars).into())
+                    .expect("Insertion not in lexicographical order!");
+            }
+            FstMap::new(builder.into_inner().unwrap()).expect("Unable to build FST map.")
+        };
+        FstDictionary { mutable_dict, word_map }
+    }
+}
 
